# ====================================================================
# LIS DONA - backend. Copiar como .env y completar.
# NUNCA subir el archivo .env al repositorio (ya esta en .gitignore).
# ====================================================================

PORT=3000
NODE_ENV=development

# --- Base de datos SQL Server ---------------------------------------
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=
DB_NAME=LisDona
DB_USER=sa
DB_PASSWORD=cambia_esta_clave
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Google OAuth 2.0 / OpenID Connect ------------------------------
# Client ID de tipo "Aplicacion web" creado en Google Cloud Console.
# Debe ser el MISMO valor que usa el frontend.
GOOGLE_CLIENT_ID=476444670258-cpeeedfg805cebs3739sjdg4hne3cku2.apps.googleusercontent.com

# Dominio institucional que identifica al perfil ESTUDIANTE.
# Cualquier otro dominio verificado entra como DONADOR.
DOMINIO_ESTUDIANTE=udea.edu.co

# --- Sesion propia de la plataforma ---------------------------------
# Cadena aleatoria larga. Generar con:  openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_largo
JWT_EXPIRES_IN=8h

# --- Administradores iniciales --------------------------------------
# Correos separados por coma. Al primer inicio de sesion reciben el rol
# ADMINISTRADOR automaticamente. Es el unico rol que no otorga otra
# persona, y se apoya en el correo verificado del token, no en datos
# enviados por el navegador.
ADMIN_EMAILS=tu.correo@gmail.com

# --- CORS ------------------------------------------------------------
# Origenes permitidos del frontend, separados por coma.
CORS_ORIGINS=http://localhost:4200

# --- Evidencia fotografica -------------------------------------------
MAX_BYTES_EVIDENCIA=2097152
