# ====================================================================
# LIS DONA - backend. Copiar como .env y completar.
# NUNCA subir el archivo .env al repositorio (ya esta en .gitignore).
# ====================================================================

PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL en Supabase (D-68) --------------------
# Panel de Supabase -> Connect -> "Session pooler" (puerto 5432, IPv4).
# Un proyecto para desarrollo y otro para produccion: este .env apunta a uno.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=lis
# Usuario de la APLICACION, con permisos minimos (migracion 003). En el
# pooler va con el ref del proyecto: lis_app.<ref>. La clave la pone
# "node scripts/db/usuario-app.js" (minimo 24 caracteres, generala con
#  openssl rand -base64 32).
DB_USER=lis_app.<ref-del-proyecto>
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_PROPIA
# Certificado CA del proyecto (Database -> SSL). La conexion exige TLS
# verificado. Ruta relativa a backend/ (la carpeta certs/ no se sube).
DB_SSL_CA=certs/supabase-dev-ca.crt

# --- Herramientas de BD (scripts/db): SOLO en tu equipo ----------------
# Usuario administrador del proyecto para migraciones, demo y usuario-app.
# Nunca lo uses en el servidor de la aplicacion.
DB_ADMIN_USER=postgres.<ref-del-proyecto>
DB_ADMIN_PASSWORD=CAMBIAR
# Los scripts solo operan sobre este proyecto (proteccion contra errores).
BD_PROYECTO_PERMITIDO=<ref-del-proyecto>
# Opcional (demo.js): casos de demostracion sobre tus cuentas reales.
# DEMO_EMAIL_DONADOR=
# DEMO_EMAIL_ESTUDIANTE=

# --- Google OAuth 2.0 / OpenID Connect ------------------------------
# Client ID de tipo "Aplicacion web" creado en Google Cloud Console.
# Debe ser el MISMO valor que usa el frontend.
GOOGLE_CLIENT_ID=476444670258-cpeeedfg805cebs3739sjdg4hne3cku2.apps.googleusercontent.com

# Dominio institucional que identifica al perfil ESTUDIANTE.
# Cualquier otro dominio verificado entra como DONADOR.
DOMINIO_ESTUDIANTE=udea.edu.co

# --- Sesion propia de la plataforma ---------------------------------
# Cadena aleatoria larga. Generar con:  openssl rand -hex 48
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_largo
JWT_EXPIRES_IN=8h

# --- Administradores iniciales --------------------------------------
# Correos separados por coma. Al primer inicio de sesion reciben el rol
# ADMINISTRADOR automaticamente. Es el unico rol que no otorga otra
# persona, y se apoya en el correo verificado del token, no en datos
# enviados por el navegador.
ADMIN_EMAILS=tu.correo@gmail.com

# --- CORS ------------------------------------------------------------
# Origenes permitidos del frontend, separados por coma.
# En produccion: la URL publica del frontend (https://...), sin "/" final.
CORS_ORIGINS=http://localhost:4200

# --- Endurecimiento HTTP (D-65) ------------------------------------
# Detras de un proxy o del hosting, cuantos saltos confiar para leer la IP
# real (X-Forwarded-For). Vacio en local.
# TRUST_PROXY=1
# Limite de peticiones por IP y minuto (login 10, fotos 30, certificado 10
# fijos; la general se ajusta aqui). "off" lo desactiva (solo pruebas).
# LIMITE_PETICIONES_MINUTO=300
# LIMITE_PETICIONES=off

# --- Evidencia fotografica -------------------------------------------
MAX_BYTES_EVIDENCIA=2097152

# --- Revisor automatico de plazos (pilar B) -------------------------
# "off" lo desactiva (p. ej. en una instancia de pruebas). Por defecto corre
# cada PLAZOS_REVISION_MINUTOS (tabla PARAMETRO).
# PLAZOS_REVISOR=off

# --- Correo (FUERA DEL ALCANCE por ahora, D-53) ---------------------
# Sin SMTP_HOST las notificaciones quedan solo en la bandeja interna.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LIS Dona <no-responder@tu-dominio>"
# CORREO_PROCESADOR=off
# CORREO_DOMINIOS_EXCLUIDOS=demo.lisdona.test,demo.udea.edu.co
